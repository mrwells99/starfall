[Unit]
Description=Ringfall dedicated arena server (%i)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ringfall
Group=ringfall
WorkingDirectory=/opt/ringfall
Environment=HOME=/opt/ringfall
# Per-instance arguments (port, mode, queue vs private lobby).
EnvironmentFile=/etc/ringfall/%i.env
# RINGFALL_ARGS is intentionally unquoted: systemd splits it into argv.
ExecStart=/usr/local/bin/godot --headless --path /opt/ringfall -- $RINGFALL_ARGS
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

# Basic hardening:
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
