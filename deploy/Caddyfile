{
	admin off
}

play.leafmods.com {
	header X-Content-Type-Options nosniff
	handle_path /downloads/* {
		root * /srv/downloads
		@stable path /manifest.json /StarfallLauncher.exe /StarfallLauncher.exe.sha256
		header @stable Cache-Control "no-store"
		@release path /releases/*
		header @release Cache-Control "public, max-age=31536000, immutable"
		file_server {
			hide .*
		}
	}
	respond "Starfall game server" 200
}

# Container health probe; this port is not published to the host.
http://:8080 {
	respond /health "ok" 200
}
