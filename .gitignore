.godot/
.env

# Screenshots and review renders. Every test run rewrites these, so tracking
# them adds multi-megabyte blobs to history forever for output that is
# regenerated on demand. Docs reference them by path; run the review tool.
# .gdignore is kept so Godot does not import whatever lands here.
artifacts/*
!artifacts/.gdignore

# Historical model workflow: local compressed backup, never include in commits.
/art_source/workflows/starfall-character-forge-v1/
# Exported clients and launcher build output
build/
launcher/bin/

# Python release tool caches
__pycache__/

# Local/server download staging
downloads/
incoming-windows/

# Owner's local reference libraries and reusable animation cache (2026-09-12).
# Keep originals on this computer; only approved runtime subsets may be promoted.
# Deliberately scoped: unrelated addons and existing shipped assets stay visible.
/addons/netfox/
/addons/netfox.internals/
/addons/Color grading/
/Compositor/Color grading/
/Compositor/General/
/addons/ezcha_network/
/addons/limboai/
/demo/
/addons/ballistic_solutions/
/addons/real_equation_solver/
/addons/BallisticSolutions.Godot/
/Unarmed/
/local_resources/
/Unarmed.glb
