; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Starfall — Arena Prototype"
run/main_scene="res://arena.tscn"
config/features=PackedStringArray("4.5")

[display]

window/size/viewport_width=1280
window/size/viewport_height=800
; 3 = Fullscreen. On every desktop platform Godot 4 implements this as a
; borderless window matching the monitor, not an exclusive mode change — so
; alt-tabbing stays instant and the desktop resolution is never touched.
; The monitor size is adopted automatically; nothing needs to detect it.
window/size/mode=3
window/stretch/mode="canvas_items"
; The 1280x800 base is 16:10. "keep" would letterbox it on a 16:9 monitor and
; "ignore" would stretch it out of shape; "expand" keeps the scale honest and
; gives back the extra width as more visible arena.
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="gl_compatibility"
environment/defaults/default_clear_color=Color(0.04, 0.06, 0.09, 1)
