# Copy to .env on the server (or let the deploy workflow write it) and adjust.
# docker compose reads this file automatically from the working directory.
#
# NOTE: nothing here is a secret. The Starfall server has no credentials, no
# database and no API keys — it is a UDP game server. Keep it that way; if a
# real secret ever appears, move it to a Docker secret rather than this file.

# --- image ------------------------------------------------------------------
# Registry path of the built image. Must match the GHCR package for this repo.
STARFALL_IMAGE=ghcr.io/mrwells99/starfall

# Which build to run. The deploy workflow rewrites this to the exact commit SHA
# so every deploy is reproducible. Avoid `latest` outside local experiments —
# it makes rollback ambiguous and defeats digest pinning.
STARFALL_TAG=latest

# --- network ----------------------------------------------------------------
# Interface the game ports bind to. 0.0.0.0 is correct for a public server;
# set to a specific IP if the droplet has several.
BIND_ADDRESS=0.0.0.0

# Public matchmaking queues. These MUST match DUEL_PORT / TEAM_PORT in
# scripts/config.gd — clients dial them by number, baked in at build time.
DUEL_PORT=27840
TEAM_PORT=27841

# The persistent world. Must match WORLD_PORT in scripts/config.gd.
WORLD_PORT=27842

# Leave disabled for queue + world only. Set to private-lobbies to enable all four.
COMPOSE_PROFILES=

# Private lobby pool. These MUST match Config.LOBBY_PORTS in scripts/config.gd.
# Adding a slot means: a port here, a port there, AND a new service in
# docker-compose.yml. All three or none.
LOBBY1_PORT=27850
LOBBY2_PORT=27851
LOBBY3_PORT=27852
LOBBY4_PORT=27853

# --- gameplay ---------------------------------------------------------------
# Humans required before a queue auto-starts a round. Remaining slots become
# bots, so TEAM_MIN_PLAYERS=2 starts a 3v3 with two humans and four bots.
DUEL_MIN_PLAYERS=2
TEAM_MIN_PLAYERS=2

# Seconds between a round ending and the automatic rematch.
REMATCH_DELAY=8

# --- resources --------------------------------------------------------------
# Per-container ceilings. Three active containers on a 1 vCPU / 1 GB host can
# contend; these stop one busy match from starving the others. Raise on a
# bigger droplet.
STARFALL_CPU_LIMIT=0.75
STARFALL_MEM_LIMIT=512M
