# Build context is only what the server needs to run. Everything here either
# gets rebuilt inside the image, is client/dev-only, or is documentation.

.git
.gitignore
.github

# Rebuilt in the builder stage. Never ship a host-generated import cache: it can
# reference absolute host paths and it is what six containers would otherwise
# race to create at startup.
.godot

# Test harnesses run on the CI runner against the source tree, not in the image.
tests/

# Screenshots produced by tests/visual_check.gd.
artifacts/

# Docs, deploy tooling and Docker files are not needed by the running server.
docs/
deploy/
*.md
Dockerfile
.dockerignore
docker-compose.yml
.env
.env.example

# Editor / OS noise
.vscode/
.idea/
*.swp
.DS_Store

# Windows distribution does not belong in the dedicated server image.
launcher/
build/
tools/release/
export_presets.cfg

# Authoring inputs are backed up in the repository, not deployed to servers.
art_source/
assets-source/
Godot/
Unity/
Unreal Engine/
.agents/
.codex/

# Local reference libraries/cache: also exclude from direct local server builds.
addons/netfox/
addons/netfox.internals/
addons/Color grading/
Compositor/Color grading/
Compositor/General/
addons/ezcha_network/
addons/limboai/
demo/
addons/ballistic_solutions/
addons/real_equation_solver/
addons/BallisticSolutions.Godot/
Unarmed/
local_resources/
Unarmed.glb
Unarmed.glb.import
Unarmed_RM.glb
Unarmed_RM.glb.import
RPG-Character-Bones.FBX
RPG-Character-Bones.FBX.import
RPG-Character.psd
RPG Animations GLB FREE Version Changes.txt
explosive_anim_importer v4.2.py
explosive_anim_importer v5.0.py
